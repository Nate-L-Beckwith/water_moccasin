# Copy to .env and edit. wm.py and docker compose both read this file.
# Values may be quoted ("like this"); a leading `export ` is tolerated.

# --- identity ----------------------------------------------------------------
# wm.py auto-detects your uid/gid (and the invoking user under sudo) and the
# host's `input` group. Uncomment only to override. Baked in at build time,
# so rebuild after changing UID/GID. INPUT_GID also applies at run time.
#UID=1000
#GID=1000
#INPUT_GID=104               # getent group input | cut -d: -f3

# --- image / container -------------------------------------------------------
IMAGE_NAME=water-moccasin/dolphin
IMAGE_TAG=latest
CONTAINER_NAME=water-moccasin
MEM_LIMIT=2g
# host (default): container shares the host's network; needed for LAN
# discovery and simplest on native Linux. bridge: publish only the netplay
# and Sunshine ports (use on Docker Desktop / WSL2 where host mode is a VM).
NETWORK_MODE=host
# Anything else to pass to `docker run`, shell-split. e.g. --gpus all
EXTRA_DOCKER_ARGS=

# --- runtime -----------------------------------------------------------------
# play | netplay-host | stream | shell
DOLPHIN_MODE=play

# Comma-separated input devices forwarded into the container. `python wm.py
# start` turns these into --device flags; `python wm.py controllers pick`
# fills it in for you. Example:
#   CONTROLLER_DEVICES=/dev/input/event22,/dev/input/js0
CONTROLLER_DEVICES=

# X display and PulseAudio socket on the host. Auto-detected (WSLg included)
# when blank; set PULSE_SERVER to unix:/path/to/socket to force one.
#DISPLAY=:0
#PULSE_SERVER=

# --- netplay -----------------------------------------------------------------
NETPLAY_PORT=2626
# Absolute path inside the container (e.g. /game/melee.iso). Leave blank to
# auto-pick the first game in ./game.
NETPLAY_GAME=

# --- streaming (Sunshine host in the container, Moonlight on the client) -----
# `python wm.py stream start` sets DOLPHIN_MODE=stream for one run.
# xvfb: headless virtual screen inside the container (no monitor needed,
#       software-rendered Dolphin). host: capture the host's X11 display.
STREAM_DISPLAY=xvfb
STREAM_RESOLUTION=1920x1080
# software (CPU, works everywhere) | vaapi (AMD/Intel via /dev/dri) | nvenc |
# quicksync | vulkan
STREAM_ENCODER=software
# uinput: Sunshine creates virtual gamepads/keyboard via /dev/uinput; Dolphin
#         reads them through evdev (gamepads work; mouse for the Qt UI does not
#         under xvfb). xtest: no /dev/uinput; keyboard+mouse go to the X server
#         instead (UI navigable, no gamepads).
STREAM_INPUT=uinput
# 1 = launch Dolphin at boot so the "Desktop" app in Moonlight shows it.
STREAM_AUTOSTART=0
# Name shown in Moonlight, web UI login, base port (others are offsets: web
# UI = +1, HTTPS = -5, RTSP = +21, UDP video/control/audio = +9..+11).
SUNSHINE_NAME=water-moccasin
SUNSHINE_USER=player
# Leave blank and `stream start` generates one and writes it here.
SUNSHINE_PASS=
SUNSHINE_PORT=47989
